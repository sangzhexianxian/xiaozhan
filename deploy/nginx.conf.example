# 放在 server { } 里。/xin/m/ 与 /xin/static/ 必须显式放行：
# 很多站点有 `location ~* \.(png|jpg)$` 这类正则，正则优先级高于普通前缀，
# 不单独 ^~ 的话图片请求会被抢去本地找文件，表现为「头像全裂」。
location /xin/ {
    proxy_pass http://127.0.0.1:8872;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 30m;
}
location ^~ /xin/m/      { proxy_pass http://127.0.0.1:8872; }
location ^~ /xin/static/ { proxy_pass http://127.0.0.1:8872; }
