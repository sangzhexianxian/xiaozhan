# 站点地址（末尾不要加斜杠）——所有通知里的链接、二维码都按这里生成
SITE_BASE=https://your-domain.com

# 有人下单 / 有人来访时，发到哪个邮箱
OPS_EMAIL=you@example.com
MAIL_FROM_NAME=我的小站

# 发信服务器（QQ 邮箱示例：smtp.qq.com + 465 + 授权码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=你的邮箱授权码

# 大模型（AI 代写信件 / 数字分身用；不填则这两块自动关掉）
LLM_BASE=https://api.deepseek.com/v1
LLM_KEY=
LLM_MODEL=deepseek-chat

# 语音合成（可选，数字分身出声用）
VOLC_KEY=
VOICE_ID=

# 运行环境（一般不用改）
PYTHON_BIN=
FFMPEG=/usr/bin/ffmpeg

# 实时通话 TRTC（可选，真人预约视频通话用）
TRTC_APPID=
TRTC_KEYFILE=
